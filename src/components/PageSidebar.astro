---
export interface SidebarSection {
  id: string;
  number: string | number;
  title: string;
  badge?: string;
  subItems?: Array<{ id: string; title: string }>;
}

export interface Props {
  title?: string;
  sections: SidebarSection[];
  featuredAirport?: {
    name: string;
    tagline: string;
    price: number | string;
    coupon: string;
    slug: string;
    speed: string;
  };
}

const {
  title = '本页大纲导览',
  sections,
  featuredAirport = {
    name: '闪电鼠',
    tagline: '2026 年度霸榜第一，IEPL+内网专线，晚高峰 980M 满跑',
    price: 8,
    coupon: 'sd88',
    slug: 'shandianshu',
    speed: '980 Mbps',
  },
} = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const sitePages = [
  { num: '1', title: '机场推荐 (年度金榜)', url: '/recommend', icon: '🏆', highlight: '主推' },
  { num: '2', title: '性价比机场 (10元平价)', url: '/cheap', icon: '💰', highlight: '省钱' },
  { num: '3', title: '机场测评 (晚高峰实测)', url: '/reviews', icon: '📊', highlight: '探针' },
  { num: '4', title: '独家 7 折专线优惠券', url: '/coupons', icon: '🎟️', highlight: '特惠' },
  { num: '5', title: '全网专线套餐价格库', url: '/plans', icon: '⚡', highlight: '对比' },
];
---

<aside class="w-full space-y-4">
  <!-- Sticky Card Container -->
  <div class="bg-white border border-surface-border rounded-2xl p-4 sm:p-5 shadow-card hover:shadow-card-hover transition-shadow space-y-5">
    
    <!-- Header: On This Page -->
    <div class="flex items-center justify-between pb-3 border-b border-surface-border">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-brand-600 animate-pulse"></span>
        <h3 class="text-xs font-black uppercase tracking-wider text-ink-heading font-mono flex items-center gap-1.5">
          <span>📑</span>
          <span>{title}</span>
        </h3>
      </div>
      <span class="text-[11px] font-mono text-ink-muted bg-surface-subtle px-2 py-0.5 rounded-full border border-surface-border">
        分 {sections.length} 个板块
      </span>
    </div>

    <!-- 1. Numbered In-Page Navigation List (分 1, 2, 3...) -->
    <nav class="space-y-1" id="sidebar-nav" aria-label="本页内容大纲">
      {sections.map((sec) => (
        <div>
          <a
            href={`#${sec.id}`}
            data-nav-id={sec.id}
            class="sidebar-nav-item group flex items-center gap-2.5 px-2.5 py-2 rounded-xl text-xs font-medium text-ink-body hover:text-brand-600 hover:bg-brand-50/70 border border-transparent hover:border-brand-200 transition-all cursor-pointer"
          >
            <!-- Number Badge (1, 2, 3...) -->
            <span class="sidebar-number shrink-0 w-6 h-6 rounded-lg bg-surface-subtle text-ink-muted group-hover:bg-brand-600 group-hover:text-white border border-surface-border font-mono font-bold text-xs flex items-center justify-center transition-all shadow-2xs">
              {sec.number}
            </span>

            <!-- Title -->
            <span class="flex-1 leading-snug truncate">
              {sec.title}
            </span>

            {sec.badge && (
              <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-amber-50 text-amber-800 border border-amber-200 shrink-0 font-mono">
                {sec.badge}
              </span>
            )}
          </a>

          <!-- Sub Items if present -->
          {sec.subItems && sec.subItems.length > 0 && (
            <div class="ml-8 pl-2 border-l border-surface-border my-1 space-y-1">
              {sec.subItems.map((sub) => (
                <a
                  href={`#${sub.id}`}
                  data-nav-id={sub.id}
                  class="sidebar-nav-sub block text-[11px] text-ink-muted hover:text-brand-600 py-0.5 truncate transition-colors"
                >
                  · {sub.title}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </nav>

    <!-- 2. Site Key Pages Hub (全站每页分 1, 2, 3) -->
    <div class="pt-4 border-t border-surface-border space-y-2.5">
      <div class="flex items-center justify-between text-[11px] font-bold text-ink-muted uppercase font-mono tracking-wider">
        <span>🌐 核心专题入口 (分 1-5 页)</span>
      </div>

      <div class="space-y-1">
        {sitePages.map((page) => {
          const isActive = currentPath === page.url;
          return (
            <a
              href={page.url}
              class={`flex items-center justify-between px-2.5 py-1.5 rounded-xl text-xs font-medium transition-all ${
                isActive
                  ? 'bg-brand-50 text-brand-700 font-bold border border-brand-200 shadow-2xs'
                  : 'text-ink-body hover:text-brand-600 hover:bg-surface-subtle border border-transparent'
              }`}
            >
              <div class="flex items-center gap-2">
                <span class={`w-5 h-5 rounded-md font-mono text-[10px] font-bold flex items-center justify-center ${
                  isActive ? 'bg-brand-600 text-white' : 'bg-surface-subtle text-ink-muted border border-surface-border'
                }`}>
                  {page.num}
                </span>
                <span class="truncate">{page.icon} {page.title}</span>
              </div>
              <span class={`text-[10px] px-1.5 py-0.2 rounded font-mono ${
                isActive ? 'bg-brand-100 text-brand-800 font-bold' : 'bg-surface-subtle text-ink-muted'
              }`}>
                {page.highlight}
              </span>
            </a>
          );
        })}
      </div>
    </div>

    <!-- 3. Mini Featured Card (Quick Conversion Pick) -->
    {featuredAirport && (
      <div class="pt-4 border-t border-surface-border space-y-3">
        <div class="flex items-center justify-between text-[11px] font-mono">
          <span class="text-amber-700 font-bold bg-amber-50 px-2 py-0.5 rounded border border-amber-200">
            ★ 本期闭眼入首选
          </span>
          <span class="text-emerald-600 font-bold font-mono">{featuredAirport.speed}</span>
        </div>

        <div>
          <div class="font-black text-sm text-ink-heading">
            {featuredAirport.name}
          </div>
          <p class="text-[11px] text-ink-muted line-clamp-2 mt-0.5 leading-relaxed">
            {featuredAirport.tagline}
          </p>
        </div>

        <div class="flex items-center justify-between text-xs">
          <div>
            <span class="text-ink-muted text-[11px]">起步价:</span>
            <span class="font-black text-ink-heading font-mono text-sm ml-1 text-brand-700">¥{featuredAirport.price}</span>
            <span class="text-[10px] text-ink-muted">/月</span>
          </div>
          {featuredAirport.coupon && (
            <button
              type="button"
              data-copy-coupon={featuredAirport.coupon}
              class="px-2 py-0.5 rounded bg-brand-50 text-brand-700 border border-brand-200 font-mono font-bold text-[11px] hover:bg-brand-100 transition-colors"
              title="点击复制优惠码"
            >
              券: {featuredAirport.coupon}
            </button>
          )}
        </div>

        <a
          href={`/go/${featuredAirport.slug}`}
          target="_blank"
          rel="nofollow sponsored noopener noreferrer"
          class="w-full block py-2 text-center rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs shadow-sm hover:shadow transition-all"
        >
          直达官网开启特惠 ➔
        </a>
      </div>
    )}

    <!-- 4. Scroll to Top Button -->
    <div class="pt-2 border-t border-surface-border text-center">
      <button
        type="button"
        id="sidebar-back-to-top"
        class="inline-flex items-center gap-1.5 text-[11px] text-ink-muted hover:text-brand-600 font-mono transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
        </svg>
        <span>返回页面顶部 (Top)</span>
      </button>
    </div>

  </div>
</aside>

<script is:inline>
  (function() {
    function initSidebarSpy() {
      var navItems = document.querySelectorAll('.sidebar-nav-item');
      var backToTop = document.getElementById('sidebar-back-to-top');

      if (backToTop) {
        backToTop.addEventListener('click', function(e) {
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      if (!navItems.length) return;

      var sectionMap = [];
      navItems.forEach(function(item) {
        var id = item.getAttribute('data-nav-id');
        if (id) {
          var targetEl = document.getElementById(id);
          if (targetEl) {
            sectionMap.push({ id: id, element: targetEl, link: item });
          }
        }
      });

      if (!sectionMap.length) return;

      // Handle smooth clicking for all anchor jumps
      navItems.forEach(function(item) {
        item.addEventListener('click', function(e) {
          var id = this.getAttribute('data-nav-id');
          if (id) {
            var target = document.getElementById(id);
            if (target) {
              e.preventDefault();
              var top = target.getBoundingClientRect().top + window.scrollY - 88;
              window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
              history.replaceState(null, null, '#' + id);
            }
          }
        });
      });

      function onScroll() {
        var activeItem = null;
        var scrollPos = window.scrollY;

        // Check each section
        for (var i = 0; i < sectionMap.length; i++) {
          var sec = sectionMap[i];
          var rect = sec.element.getBoundingClientRect();
          // Active if upper portion of section is visible
          if (rect.top <= 160 && rect.bottom > 120) {
            activeItem = sec.link;
            break;
          }
        }

        // If at the very top, activate first
        if (scrollPos < 120 && sectionMap.length > 0) {
          activeItem = sectionMap[0].link;
        }

        // If at the very bottom, activate last
        if (!activeItem && (window.innerHeight + scrollPos) >= document.body.offsetHeight - 100) {
          activeItem = sectionMap[sectionMap.length - 1].link;
        }

        navItems.forEach(function(item) {
          var numBadge = item.querySelector('.sidebar-number');
          if (item === activeItem) {
            item.classList.add('bg-brand-50', 'text-brand-600', 'border-brand-200', 'font-bold');
            item.classList.remove('text-ink-body', 'border-transparent');
            if (numBadge) {
              numBadge.classList.add('bg-brand-600', 'text-white', 'border-brand-600');
              numBadge.classList.remove('bg-surface-subtle', 'text-ink-muted', 'border-surface-border');
            }
          } else {
            item.classList.remove('bg-brand-50', 'text-brand-600', 'border-brand-200', 'font-bold');
            item.classList.add('text-ink-body', 'border-transparent');
            if (numBadge) {
              numBadge.classList.remove('bg-brand-600', 'text-white', 'border-brand-600');
              numBadge.classList.add('bg-surface-subtle', 'text-ink-muted', 'border-surface-border');
            }
          }
        });
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSidebarSpy);
    } else {
      initSidebarSpy();
    }
  })();
</script>
