---
import SearchModal from './SearchModal.astro';

const currentPath = Astro.url.pathname;

const primaryNav = [
  { href: '/', label: '首页', id: 'home' },
  { href: '/recommend', label: '🏆 机场推荐', id: 'recommend' },
  { href: '/cheap', label: '💰 性价比机场', id: 'cheap' },
  { href: '/reviews', label: '📊 机场测评', id: 'reviews' },
];

const dropdownSections = [
  {
    category: '预算与优惠',
    items: [
      { href: '/plans', label: '套餐横向对比', desc: '全网周期与流量资费表' },
      { href: '/coupons', label: '独家大额优惠码', desc: '折减 7 折专属券汇总' },
    ],
  },
  {
    category: '场景与工具',
    items: [
      { href: '/ai', label: 'AI 原生住宅机场', desc: 'ChatGPT / Claude 专线' },
      { href: '/streaming', label: '流媒体解锁机场', desc: 'Netflix 4K & TikTok' },
    ],
  },
  {
    category: '下载与排障',
    items: [
      { href: '/clients', label: '客户端配置教程', desc: 'Clash / Sing-box / 小火箭' },
      { href: '/troubleshooting', label: '网络排障与防封', desc: '节点超时与阻断排查' },
    ],
  },
  {
    category: '知识与资料',
    items: [
      { href: '/wiki', label: '专线百科科普', desc: 'IPLC / IEPL / 协议通识' },
      { href: '/airports', label: '机场大全索引', desc: '收录品牌全览与状态' },
    ],
  },
];
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-surface-border transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-18">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group shrink-0">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-brand-600 to-brand-700 p-0.5 shadow-sm transition-transform group-hover:scale-105">
          <div class="w-full h-full bg-white rounded-[9px] flex items-center justify-center">
            <svg class="w-5 h-5 text-brand-600" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
          </div>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="text-lg font-black tracking-tight text-ink-heading group-hover:text-brand-600 transition-colors">
              机场社长
            </span>
            <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-brand-50 text-brand-700 border border-brand-200 uppercase tracking-wider font-mono">
              LABS
            </span>
          </div>
          <span class="text-[11px] text-ink-muted block -mt-1 font-normal">
            2026 高速 IPLC 专线实测中心
          </span>
        </div>
      </a>

      <!-- Desktop 5 Core Navigation Silos -->
      <nav class="hidden lg:flex items-center gap-1">
        {primaryNav.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`px-3.5 py-2 rounded-lg text-sm font-medium transition-all ${
                isActive
                  ? 'text-brand-600 bg-brand-50 font-bold'
                  : 'text-ink-body hover:text-ink-heading hover:bg-surface-subtle'
              }`}
            >
              {link.label}
            </a>
          );
        })}

        <!-- 5th Core Entry: 全部专题 ▾ (Dropdown Menu) -->
        <div class="relative group" id="desktop-topics-dropdown">
          <button
            type="button"
            class="flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-sm font-medium text-ink-body group-hover:text-brand-600 hover:bg-surface-subtle transition-all"
            aria-expanded="false"
          >
            <span>全部专题</span>
            <svg class="w-4 h-4 text-ink-muted group-hover:text-brand-600 group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Dropdown Mega Menu -->
          <div class="absolute right-0 top-full pt-2 w-[600px] hidden group-hover:block animate-in fade-in zoom-in-95 duration-150">
            <div class="bg-white rounded-2xl border border-surface-border shadow-2xl p-5 grid grid-cols-2 gap-5">
              {dropdownSections.map((sec) => (
                <div class="space-y-2">
                  <div class="text-[11px] font-bold text-ink-muted uppercase tracking-wider px-2 font-mono">
                    {sec.category}
                  </div>
                  <div class="space-y-1">
                    {sec.items.map((item) => (
                      <a
                        href={item.href}
                        class="block px-2.5 py-2 rounded-xl hover:bg-surface-subtle transition-colors group/item"
                      >
                        <div class="text-xs font-bold text-ink-heading group-hover/item:text-brand-600">
                          {item.label}
                        </div>
                        <div class="text-[11px] text-ink-muted mt-0.5">
                          {item.desc}
                        </div>
                      </a>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </nav>

      <!-- Right CTAs & Search Modal Trigger -->
      <div class="hidden sm:flex items-center gap-3">
        <!-- Pagefind Search Modal Component (⌘K) -->
        <SearchModal />
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex items-center gap-2 lg:hidden">
        <SearchModal />
        <button
          id="mobile-menu-btn"
          type="button"
          class="p-2 rounded-lg text-ink-body hover:text-ink-heading hover:bg-surface-subtle border border-surface-border"
          aria-label="打开菜单"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Navigation Tree -->
  <div id="mobile-menu" class="hidden lg:hidden border-b border-surface-border bg-white px-4 pt-3 pb-6 space-y-3 max-h-[80vh] overflow-y-auto">
    <div class="space-y-1">
      {primaryNav.map((link) => (
        <a
          href={link.href}
          class="block px-3 py-2.5 rounded-lg text-sm font-semibold text-ink-heading hover:bg-surface-subtle hover:text-brand-600"
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Mobile Dropdown Sections -->
    <div class="pt-2 border-t border-surface-border space-y-4">
      {dropdownSections.map((sec) => (
        <div class="space-y-1">
          <div class="text-[11px] font-bold text-ink-muted uppercase tracking-wider px-3 font-mono">
            {sec.category}
          </div>
          <div class="grid grid-cols-2 gap-1.5 px-2">
            {sec.items.map((item) => (
              <a
                href={item.href}
                class="block px-2.5 py-1.5 rounded-lg bg-surface-subtle text-xs font-medium text-ink-body hover:text-brand-600"
              >
                {item.label}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</header>

<script is:inline>
  (function() {
    var mobileBtn = document.getElementById('mobile-menu-btn');
    var mobileMenu = document.getElementById('mobile-menu');

    if (mobileBtn && mobileMenu) {
      mobileBtn.addEventListener('click', function() {
        mobileMenu.classList.toggle('hidden');
      });
    }
  })();
</script>
