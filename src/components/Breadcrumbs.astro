---
import JsonLd from './seo/JsonLd.astro';
import { generateBreadcrumbSchema } from '../utils/seo';

export interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

const allItems = [
  { label: '首页', href: '/' },
  ...items,
];

const schema = generateBreadcrumbSchema(allItems);
---

<nav aria-label="Breadcrumb" class="py-4 text-xs text-ink-muted">
  <ol class="flex items-center gap-2 flex-wrap">
    {allItems.map((item, index) => {
      const isLast = index === allItems.length - 1;
      return (
        <li class="flex items-center gap-2">
          {index > 0 && <span class="text-slate-300">/</span>}
          {isLast || !item.href ? (
            <span class="text-ink-heading font-semibold" aria-current="page">
              {item.label}
            </span>
          ) : (
            <a href={item.href} class="hover:text-brand-600 transition-colors">
              {item.label}
            </a>
          )}
        </li>
      );
    })}
  </ol>
  <JsonLd schema={schema} />
</nav>
