---
const hubs = [
  {
    href: '/recommend',
    title: '🏆 机场推荐 (年度总榜)',
    subtitle: '年度总榜 · 流媒体与 AI 解锁 · 商业选型',
    desc: '基于 7×24 小时真实物理探针评测。涵盖年度总榜、Netflix/Disney+ 4K 解锁、ChatGPT/Claude 原生住宅直连及跨境出海独享 IP。',
    tag: '年度金奖',
    tagColor: 'bg-amber-50 text-amber-800 border-amber-200',
    linkText: '进入推荐专区 ➔',
    stats: '11 款精选专线已收录',
  },
  {
    href: '/cheap',
    title: '💰 性价比机场 (平价专区)',
    subtitle: '10元内平价梯子 · 按量计费 · 不限时',
    desc: '专为学生党、轻量冲浪与备用防失联用户量身定制。涵盖 7-15 元/月高性价比专线、不限时按量流量包实测与资费精算。',
    tag: '月付 ¥7 起',
    tagColor: 'bg-emerald-50 text-emerald-800 border-emerald-200',
    linkText: '查看平价专线 ➔',
    stats: '按量不限时不过期',
  },
  {
    href: '/reviews',
    title: '📊 机场测评 (实验室测速)',
    subtitle: '晚高峰测速 · 丢包与抖动 · 深度拆解',
    desc: '拒绝恰烂钱与虚标带宽。实验室部署多地千兆宽带，深度拆解 IPLC 物理光纤拓扑，发布晚高峰测速天梯榜与真实丢包评测。',
    tag: '实验室实测',
    tagColor: 'bg-blue-50 text-brand-700 border-blue-200',
    linkText: '阅读实测报告 ➔',
    stats: '晚高峰 980Mbps 验证',
  },
];
---

<section class="my-14" id="silo-hubs">
  <div class="text-center max-w-3xl mx-auto mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-200 text-brand-700 text-xs font-semibold mb-2">
      🧭 按需精准选型 · 三大核心专区
    </div>
    <h2 class="text-2xl sm:text-3xl font-black text-ink-heading">
      三大精选专区直达
    </h2>
    <p class="text-xs sm:text-sm text-ink-muted mt-1">
      根据你的预算与使用场景，快速找到最合适的专线梯子
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {hubs.map((hub) => (
      <a
        href={hub.href}
        class="bg-white rounded-2xl border border-surface-border p-6 shadow-card hover:shadow-card-hover hover:border-brand-400 transition-all flex flex-col justify-between group"
      >
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class={`text-[11px] font-bold px-2.5 py-0.5 rounded-full border ${hub.tagColor}`}>
              {hub.tag}
            </span>
            <span class="text-[11px] text-ink-muted font-mono">{hub.stats}</span>
          </div>

          <h3 class="text-xl font-black text-ink-heading group-hover:text-brand-600 transition-colors">
            {hub.title}
          </h3>

          <div class="text-xs font-semibold text-brand-700">
            {hub.subtitle}
          </div>

          <p class="text-xs sm:text-sm text-ink-body leading-relaxed7">
            {hub.desc}
          </p>
        </div>

        <div class="pt-6 mt-6 border-t border-surface-border flex items-center justify-between text-xs font-semibold text-brand-600 group-hover:translate-x-1 transition-transform">
          <span>{hub.linkText}</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </div>
      </a>
    ))}
  </div>
</section>

