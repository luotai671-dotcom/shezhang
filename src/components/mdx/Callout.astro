---
export interface Props {
  type?: 'info' | 'warning' | 'success' | 'tip';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const styles = {
  info: {
    bg: 'bg-blue-50/70',
    border: 'border-blue-200',
    title: 'text-brand-700',
    icon: 'ℹ️',
  },
  warning: {
    bg: 'bg-amber-50/70',
    border: 'border-amber-200',
    title: 'text-amber-800',
    icon: '⚠️',
  },
  success: {
    bg: 'bg-emerald-50/70',
    border: 'border-emerald-200',
    title: 'text-emerald-800',
    icon: '✓',
  },
  tip: {
    bg: 'bg-purple-50/70',
    border: 'border-purple-200',
    title: 'text-purple-800',
    icon: '💡',
  },
};

const current = styles[type];
---

<div class={`my-6 p-4 sm:p-5 rounded-2xl border ${current.bg} ${current.border} shadow-sm`}>
  <div class="flex items-start gap-3">
    <span class="text-lg shrink-0 mt-0.5">{current.icon}</span>
    <div class="space-y-1 text-sm text-ink-body leading-relaxed7">
      {title && (
        <div class={`font-bold ${current.title} text-sm sm:text-base mb-1`}>
          {title}
        </div>
      )}
      <div class="prose prose-sm max-w-none text-ink-body">
        <slot />
      </div>
    </div>
  </div>
</div>

