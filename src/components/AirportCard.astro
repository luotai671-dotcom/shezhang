---
import type { CollectionEntry } from 'astro:content';
import VerificationBadge from './VerificationBadge.astro';

export interface Props {
  airport: CollectionEntry<'airports'>;
  index?: number;
}

const { airport } = Astro.props;
const data = airport.data;

const badgeColorClasses = {
  gold: 'bg-amber-50 text-amber-800 border-amber-200',
  cyan: 'bg-sky-50 text-sky-800 border-sky-200',
  purple: 'bg-purple-50 text-purple-800 border-purple-200',
  emerald: 'bg-emerald-50 text-emerald-800 border-emerald-200',
  rose: 'bg-rose-50 text-rose-800 border-rose-200',
  brand: 'bg-blue-50 text-blue-800 border-blue-200',
};

const badgeClass = badgeColorClasses[data.badgeColor || 'brand'];
---

<article
  class="airport-card group relative bg-white rounded-2xl border border-surface-border hover:border-brand-400 transition-all duration-300 shadow-card hover:shadow-card-hover flex flex-col justify-between overflow-hidden"
  data-category={data.category}
  data-price={data.priceMonthly}
  data-speed={data.metrics.peakSpeedMbps}
  data-rating={data.rating}
>
  <!-- Top Highlight Bar for Featured Item -->
  {data.featured && (
    <div class="h-1 w-full bg-brand-600"></div>
  )}

  <div class="p-5 sm:p-6 space-y-4">
    
    <!-- Header: Row 1 - Rank, Full Airport Name (NO truncate, full visibility), and Badge -->
    <div class="flex items-center justify-between gap-2.5">
      <div class="flex items-center gap-2.5 min-w-0">
        <!-- Rank Pill -->
        <span class="w-8 h-8 rounded-lg bg-brand-50 text-brand-700 font-mono font-black text-sm flex items-center justify-center border border-brand-200 shrink-0">
          #{data.rankOrder}
        </span>
        <!-- Full Airport Name: NEVER truncated, crystal clear full name display -->
        <h2 class="text-xl sm:text-2xl font-black text-ink-heading group-hover:text-brand-600 transition-colors whitespace-nowrap">
          <a href={`/airports/${airport.slug}`}>
            {data.name}
          </a>
        </h2>
      </div>

      <!-- Custom Recommendation Badge -->
      {data.badge && (
        <span class={`text-[11px] font-bold px-2.5 py-0.5 rounded-full border shrink-0 whitespace-nowrap ${badgeClass}`}>
          {data.badge}
        </span>
      )}
    </div>

    <!-- Header: Row 2 - Line Type, Verification Badge, and Trust Info -->
    <div class="flex items-center gap-2 flex-wrap text-xs pt-0.5">
      <span class="px-2 py-0.5 rounded-md font-medium bg-surface-subtle text-ink-heading border border-surface-border shrink-0 font-mono text-[11px]">
        {data.lineType}
      </span>
      <VerificationBadge status={data.dataVerificationStatus || 'independent_tested'} />
      <div class="flex items-center gap-1.5 text-xs text-ink-muted ml-auto font-mono shrink-0">
        <span class="text-amber-500 font-bold">★ {data.rating.toFixed(2)}</span>
        <span>·</span>
        <span>{data.establishedYear} 至今</span>
      </div>
    </div>

    <!-- Tagline / Quick Summary for AEO (Clean 2-line clamp with uniform height) -->
    <div class="text-xs sm:text-sm text-ink-body leading-relaxed bg-surface-subtle p-3 rounded-xl border border-surface-border/60 min-h-[56px] flex items-center">
      <p class="line-clamp-2">
        “{data.tagline}”
      </p>
    </div>

    <!-- ======================================================== -->
    <!-- 整齐排版：Performance Telemetry Grid (3 Top + 2 Bottom) -->
    <!-- 彻底解决 5 列文字垂直单字挤压与重叠错位问题 -->
    <!-- ======================================================== -->
    <div class="bg-surface-subtle p-3 rounded-2xl border border-surface-border space-y-2">
      <!-- 1. 上层 3 大核心网络参数 (平均三等分，横向充足不折行) -->
      <div class="grid grid-cols-3 gap-2 text-center">
        <!-- 晚高峰测速 -->
        <div class="bg-white py-2 px-1 rounded-xl border border-surface-border/80 shadow-2xs">
          <span class="text-[11px] text-ink-muted block font-sans leading-none mb-1 whitespace-nowrap">晚高峰测速</span>
          <span class="text-sm sm:text-base font-black text-brand-600 font-mono leading-tight block whitespace-nowrap">
            {data.metrics.peakSpeedMbps}
            <span class="text-[10px] font-normal text-ink-muted ml-0.5">Mbps</span>
          </span>
        </div>

        <!-- 专线延迟 -->
        <div class="bg-white py-2 px-1 rounded-xl border border-surface-border/80 shadow-2xs">
          <span class="text-[11px] text-ink-muted block font-sans leading-none mb-1 whitespace-nowrap">专线延迟</span>
          <span class="text-sm sm:text-base font-black text-emerald-600 font-mono leading-tight block whitespace-nowrap">
            {data.metrics.pingMs}
            <span class="text-[10px] font-normal text-ink-muted ml-0.5">ms</span>
          </span>
        </div>

        <!-- 晚高峰丢包 -->
        <div class="bg-white py-2 px-1 rounded-xl border border-surface-border/80 shadow-2xs">
          <span class="text-[11px] text-ink-muted block font-sans leading-none mb-1 whitespace-nowrap">晚高峰丢包</span>
          <span class="text-sm sm:text-base font-black text-ink-heading font-mono leading-tight block whitespace-nowrap">
            {data.metrics.packetLoss}
          </span>
        </div>
      </div>

      <!-- 2. 下层 2 大解锁认证横条 (左右对齐，清晰舒展) -->
      <div class="grid grid-cols-2 gap-2 text-xs font-mono">
        <div class="bg-white px-2.5 py-1.5 rounded-xl border border-surface-border/80 shadow-2xs flex items-center justify-between">
          <span class="text-[11px] font-sans text-ink-muted whitespace-nowrap">IP 纯净度</span>
          <span class="font-bold text-emerald-700 text-xs whitespace-nowrap flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
            <span>{data.metrics.scamalyticsScore ?? 0}分 极低</span>
          </span>
        </div>

        <div class="bg-white px-2.5 py-1.5 rounded-xl border border-surface-border/80 shadow-2xs flex items-center justify-between">
          <span class="text-[11px] font-sans text-ink-muted whitespace-nowrap">流媒体画质</span>
          <span class="font-bold text-amber-700 text-xs whitespace-nowrap">
            {data.metrics.maxStreamingQuality}
          </span>
        </div>
      </div>
    </div>

    <!-- Unlock & Protocol Badges (Clean aligned rows) -->
    <div class="space-y-2 pt-1 text-xs">
      <div class="flex items-center gap-1.5 flex-wrap">
        <span class="text-ink-muted font-medium text-[11px] shrink-0">全绿解锁:</span>
        <span class="px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200 text-[11px] font-medium whitespace-nowrap">✓ ChatGPT 4o</span>
        <span class="px-2 py-0.5 rounded-md bg-blue-50 text-blue-700 border border-blue-200 text-[11px] font-medium whitespace-nowrap">✓ Netflix 4K</span>
        <span class="px-2 py-0.5 rounded-md bg-indigo-50 text-indigo-700 border border-indigo-200 text-[11px] font-medium whitespace-nowrap">✓ Disney+</span>
        <span class="px-2 py-0.5 rounded-md bg-rose-50 text-rose-700 border border-rose-200 text-[11px] font-medium whitespace-nowrap">✓ TikTok</span>
      </div>
      <div class="flex items-center gap-1.5 flex-wrap">
        <span class="text-ink-muted font-medium text-[11px] shrink-0">支持协议:</span>
        {data.protocols.map((protocol) => (
          <span class="px-2 py-0.5 rounded-md bg-white text-ink-heading border border-surface-border font-mono text-[11px] whitespace-nowrap">
            {protocol}
          </span>
        ))}
      </div>
    </div>

    <!-- Pros Bullet Points (Strictly 2 lines for uniform card alignment) -->
    <div class="space-y-1 pt-1">
      <div class="text-xs font-bold text-ink-heading">社长实测亮点：</div>
      <ul class="space-y-1 text-xs text-ink-body">
        {data.pros.slice(0, 2).map((pro) => (
          <li class="flex items-start gap-1.5">
            <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
            <span class="leading-relaxed line-clamp-1">{pro}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Transparent Con Notice -->
    {data.cons.length > 0 && (
      <div class="text-[11px] text-ink-body bg-amber-50/60 p-2.5 rounded-xl border border-amber-200/80 flex items-start gap-1.5">
        <span class="text-amber-700 font-bold shrink-0">⚠️ 体验注意:</span>
        <span class="line-clamp-1">{data.cons[0]}</span>
      </div>
    )}

  </div>

  <!-- Card Action Footer: Structured 2-Row Layout (Price + Coupon + 50/50 CTA Buttons) -->
  <div class="p-5 bg-surface-subtle/70 border-t border-surface-border space-y-3">
    
    <!-- Top Line: Price & Coupon Button -->
    <div class="flex items-center justify-between">
      <div class="flex items-baseline gap-1">
        <span class="text-xs text-ink-muted">起步:</span>
        <span class="text-2xl font-black text-brand-700 font-mono tracking-tight">{data.currency}{data.priceMonthly}</span>
        <span class="text-xs text-ink-muted">/月</span>
        {data.discountRate && (
          <span class="ml-1 text-[10px] px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 border border-amber-200 font-bold font-mono">
            立享{data.discountRate}
          </span>
        )}
      </div>

      <!-- Coupon Badge with 1-Click Copy -->
      {data.couponCode ? (
        <button
          type="button"
          data-copy-coupon={data.couponCode}
          class="flex items-center gap-1 px-2.5 py-1 rounded-lg bg-white border border-brand-200 hover:border-brand-500 text-brand-700 hover:bg-brand-50 transition-all text-xs font-mono shadow-2xs group/btn"
          title="点击复制优惠券代码"
        >
          <span class="text-ink-muted text-[11px] group-hover/btn:text-ink-body">券:</span>
          <span class="font-bold underline decoration-dotted">{data.couponCode}</span>
          <svg class="w-3 h-3 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
        </button>
      ) : (
        <span class="text-[11px] text-ink-muted font-mono bg-white px-2 py-0.5 rounded border border-surface-border">
          官方直降
        </span>
      )}
    </div>

    <!-- Bottom Line: 2 Balanced Action Buttons (50% / 50% split) -->
    <div class="grid grid-cols-2 gap-2">
      <a
        href={`/airports/${airport.slug}`}
        class="text-center py-2.5 px-3 rounded-xl bg-white border border-surface-border hover:border-brand-300 hover:text-brand-600 text-xs font-semibold text-ink-heading transition-all shadow-2xs"
      >
        评测详情
      </a>
      
      <!-- Primary Affiliate CTA: Cloaked /go/[slug] redirect -->
      <a
        href={`/go/${data.affiliateSlug}`}
        target="_blank"
        rel="nofollow sponsored noopener noreferrer"
        class="text-center py-2.5 px-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-bold shadow-sm hover:shadow transition-all active:scale-95 flex items-center justify-center gap-1"
      >
        <span>官网上车</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>

  </div>
</article>
