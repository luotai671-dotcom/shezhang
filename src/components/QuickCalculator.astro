---
---

<section class="my-12 bg-white border border-surface-border rounded-3xl p-6 sm:p-8 shadow-card" id="calculator">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-surface-border">
    <div>
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-blue-50 border border-blue-200 text-brand-700 text-xs font-semibold mb-1">
        🧮 流量与预算精算
      </div>
      <h2 class="text-xl sm:text-2xl font-black text-ink-heading">
        科学上网流量与预算计算器
      </h2>
      <p class="text-xs sm:text-sm text-ink-muted">
        拖动滑块选择你的日常用量，帮你算清每月花多少钱最划算，拒绝买多浪费
      </p>
    </div>
    <div class="flex items-center gap-2 text-xs text-ink-muted font-mono">
      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
      <span>2026 最新资费数据库已同步</span>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mt-6">
    
    <!-- Controls (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      
      <!-- Control 1: Monthly Traffic Slider -->
      <div>
        <div class="flex items-center justify-between text-xs font-bold text-ink-heading mb-2">
          <span>预计月度流量需求：</span>
          <span class="text-brand-600 font-mono text-base" id="calc-traffic-val">150 GB</span>
        </div>
        <input
          type="range"
          id="calc-traffic-slider"
          min="20"
          max="800"
          step="10"
          value="150"
          class="w-full h-2 bg-surface-subtle rounded-lg appearance-none cursor-pointer accent-brand-600"
        />
        <div class="flex justify-between text-[11px] text-ink-muted font-mono mt-1">
          <span>20 GB (轻度)</span>
          <span>150 GB (日常)</span>
          <span>400 GB (影音)</span>
          <span>800 GB+ (重度)</span>
        </div>
      </div>

      <!-- Control 2: Device Count -->
      <div>
        <label class="block text-xs font-bold text-ink-heading mb-2">
          同时在线设备数量：
        </label>
        <div class="grid grid-cols-3 gap-2.5" id="calc-device-group">
          <button
            type="button"
            data-devices="1-2"
            class="calc-dev-btn active py-2 px-3 rounded-xl bg-brand-50 border border-brand-600 text-brand-700 text-xs font-bold transition-all shadow-sm"
          >
            1 - 2 台 (个人)
          </button>
          <button
            type="button"
            data-devices="3-5"
            class="calc-dev-btn py-2 px-3 rounded-xl bg-surface-subtle border border-surface-border text-ink-body text-xs font-medium hover:bg-slate-100 transition-all"
          >
            3 - 5 台 (多终端)
          </button>
          <button
            type="button"
            data-devices="team"
            class="calc-dev-btn py-2 px-3 rounded-xl bg-surface-subtle border border-surface-border text-ink-body text-xs font-medium hover:bg-slate-100 transition-all"
          >
            5台以上 (团队/家庭)
          </button>
        </div>
      </div>

      <!-- Control 3: Purpose Focus -->
      <div>
        <label class="block text-xs font-bold text-ink-heading mb-2">
          主要加速用途：
        </label>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2" id="calc-purpose-group">
          <button
            type="button"
            data-purpose="ai"
            class="calc-pur-btn active py-2 px-2.5 rounded-xl bg-brand-50 border border-brand-600 text-brand-700 text-xs font-bold transition-all text-center"
          >
            🤖 AI 研发办公
          </button>
          <button
            type="button"
            data-purpose="stream"
            class="calc-pur-btn py-2 px-2.5 rounded-xl bg-surface-subtle border border-surface-border text-ink-body text-xs font-medium hover:bg-slate-100 transition-all text-center"
          >
            🎬 4K/8K 追剧
          </button>
          <button
            type="button"
            data-purpose="game"
            class="calc-pur-btn py-2 px-2.5 rounded-xl bg-surface-subtle border border-surface-border text-ink-body text-xs font-medium hover:bg-slate-100 transition-all text-center"
          >
            🎮 游戏低延迟
          </button>
          <button
            type="button"
            data-purpose="business"
            class="calc-pur-btn py-2 px-2.5 rounded-xl bg-surface-subtle border border-surface-border text-ink-body text-xs font-medium hover:bg-slate-100 transition-all text-center"
          >
            🌍 跨境出海
          </button>
        </div>
      </div>

    </div>

    <!-- Output Result (5 cols) -->
    <div class="lg:col-span-5 bg-surface-subtle border border-brand-200 rounded-2xl p-5 sm:p-6 flex flex-col justify-between space-y-4 shadow-sm">
      
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-emerald-700 uppercase tracking-wider font-mono">
            ✓ 推荐套餐测算
          </span>
          <span class="text-[11px] px-2 py-0.5 rounded bg-white text-ink-muted border border-surface-border font-mono">
            IPLC 物理专线
          </span>
        </div>

        <div>
          <div class="text-xs text-ink-muted">推荐最佳上车机场：</div>
          <h3 id="calc-res-airport" class="text-xl font-black text-ink-heading mt-0.5">
            闪电鼠 · 综合霸榜旗舰专线
          </h3>
        </div>

        <div class="grid grid-cols-2 gap-2 pt-1 font-mono text-xs">
          <div class="bg-white p-2.5 rounded-xl border border-surface-border">
            <span class="text-[10px] text-ink-muted block font-sans">预估月费</span>
            <span id="calc-res-price" class="text-base font-black text-brand-600">¥8</span> /月起
          </div>
          <div class="bg-white p-2.5 rounded-xl border border-surface-border">
            <span class="text-[10px] text-ink-muted block font-sans">单 G 流量成本</span>
            <span id="calc-res-unit" class="text-base font-bold text-ink-heading">¥0.05</span> /GB
          </div>
        </div>

        <p id="calc-res-desc" class="text-xs text-ink-body leading-relaxed bg-white p-3 rounded-xl border border-surface-border">
          IEPL+内网专线，晚高峰千兆 980Mbps 满跑，100% 原生解锁 ChatGPT 4o 与 Netflix 4K，起步仅需 ¥8/月。
        </p>
      </div>

      <div class="pt-2 border-t border-surface-border space-y-2">
        <div class="flex items-center justify-between text-xs">
          <span class="text-ink-muted">专属 88 折优惠券：</span>
          <code id="calc-res-coupon" class="px-2 py-0.5 rounded bg-brand-50 text-brand-700 font-mono font-bold border border-brand-200">
            sd88
          </code>
        </div>
        <a
          id="calc-res-cta"
          href="/go/shandianshu"
          target="_blank"
          rel="nofollow sponsored noopener noreferrer"
          class="w-full block py-2.5 px-4 text-center rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs shadow-sm transition-all"
        >
          直达官网开启特惠 ➔
        </a>
      </div>

    </div>

  </div>
</section>

<script is:inline>
  (function() {
    function setupCalculator() {
      var slider = document.getElementById('calc-traffic-slider');
      var trafficVal = document.getElementById('calc-traffic-val');
      var devBtns = document.querySelectorAll('#calc-device-group .calc-dev-btn');
      var purBtns = document.querySelectorAll('#calc-purpose-group .calc-pur-btn');

      var resAirport = document.getElementById('calc-res-airport');
      var resPrice = document.getElementById('calc-res-price');
      var resUnit = document.getElementById('calc-res-unit');
      var resDesc = document.getElementById('calc-res-desc');
      var resCoupon = document.getElementById('calc-res-coupon');
      var resCta = document.getElementById('calc-res-cta');

      var currentTraffic = 150;
      var currentDevices = '1-2';
      var currentPurpose = 'ai';

      function calculate() {
        if (!resAirport || !resPrice || !resUnit || !resDesc || !resCoupon || !resCta) return;

        if (currentPurpose === 'game' || (currentTraffic <= 100 && currentDevices === '1-2')) {
          resAirport.textContent = '光年梯 · 极限平价尝鲜';
          resPrice.textContent = '¥7';
          resUnit.textContent = (7 / currentTraffic).toFixed(2);
          resDesc.textContent = 'IEPL 极速专线，支持 VLESS 协议，起步仅需 ¥7/月，学生与轻度用户首选。';
          resCoupon.textContent = '官方直通特惠';
          resCta.href = '/go/guangnianti';
        } else if (currentPurpose === 'business') {
          resAirport.textContent = '大佬云 · 商务稳定专线';
          resPrice.textContent = '¥8';
          resUnit.textContent = (8 / currentTraffic).toFixed(2);
          resDesc.textContent = 'IEPL 物理专线集群，支持原生住宅 IP 解锁，高可用不掉线，专属 88 折【dly88】。';
          resCoupon.textContent = 'dly88';
          resCta.href = '/go/dalaoyun';
        } else if (currentDevices === 'team' || currentTraffic >= 400) {
          resAirport.textContent = '神行加速 · 企业大带宽';
          resPrice.textContent = '¥15';
          resUnit.textContent = (15 / currentTraffic).toFixed(2);
          resDesc.textContent = 'IEPL 专线大带宽，多设备并发毫无压力，晚高峰满载不限速，专属优惠码【sx0077】。';
          resCoupon.textContent = 'sx0077';
          resCta.href = '/go/shenxing';
        } else {
          // Default Flagship
          resAirport.textContent = '闪电鼠 · 综合霸榜旗舰专线';
          resPrice.textContent = '¥8';
          resUnit.textContent = (8 / currentTraffic).toFixed(2);
          resDesc.textContent = '2026 年度实测第一，IEPL+内网专线全绿秒开，晚高峰千兆满跑，专属 88 折【sd88】。';
          resCoupon.textContent = 'sd88';
          resCta.href = '/go/shandianshu';
        }
      }

      if (slider) {
        slider.addEventListener('input', function(e) {
          currentTraffic = Number(e.target.value);
          if (trafficVal) trafficVal.textContent = currentTraffic + ' GB';
          calculate();
        });
      }

      devBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          devBtns.forEach(function(b) {
            b.classList.remove('active', 'bg-brand-50', 'border-brand-600', 'text-brand-700', 'font-bold');
            b.classList.add('bg-surface-subtle', 'border-surface-border', 'text-ink-body', 'font-medium');
          });
          btn.classList.add('active', 'bg-brand-50', 'border-brand-600', 'text-brand-700', 'font-bold');
          btn.classList.remove('bg-surface-subtle', 'border-surface-border', 'text-ink-body', 'font-medium');
          currentDevices = btn.getAttribute('data-devices') || '1-2';
          calculate();
        });
      });

      purBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          purBtns.forEach(function(b) {
            b.classList.remove('active', 'bg-brand-50', 'border-brand-600', 'text-brand-700', 'font-bold');
            b.classList.add('bg-surface-subtle', 'border-surface-border', 'text-ink-body', 'font-medium');
          });
          btn.classList.add('active', 'bg-brand-50', 'border-brand-600', 'text-brand-700', 'font-bold');
          btn.classList.remove('bg-surface-subtle', 'border-surface-border', 'text-ink-body', 'font-medium');
          currentPurpose = btn.getAttribute('data-purpose') || 'ai';
          calculate();
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupCalculator);
    } else {
      setupCalculator();
    }
  })();
</script>

