---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { getCollection } from 'astro:content';
import { generateItemListSchema, generateArticleSchema } from '../../utils/seo';

const airports = await getCollection('airports');
airports.sort((a, b) => a.data.rankOrder - b.data.rankOrder);

const itemListSchema = generateItemListSchema(
  airports.map((a) => ({
    name: a.data.name,
    slug: a.slug,
    rankOrder: a.data.rankOrder,
    tagline: a.data.tagline,
    rating: a.data.rating,
  }))
);

const articleSchema = generateArticleSchema({
  title: '2026 年度翻墙机场综合权威排行榜 | 真实 IPLC 专线测速与选购榜单',
  description: '由机场社长实验室经过 30 天连续 7×24 小时探针测速评选出的 2026 年度高可用翻墙梯子机场排行榜。涵盖晚高峰测速、ChatGPT解锁与优惠码汇总。',
  publishDate: '2026-01-01',
  updatedDate: '2026-11-10',
  author: '机场社长 实验室',
  url: 'https://jichangshezhang.com/rankings',
});
---

<BaseLayout
  title="2026 翻墙机场权威排行榜 | 11大顶级 IPLC/IEPL 专线实测对比与选购指南"
  description="2026 翻墙机场最新排行榜：综合考虑晚高峰带宽、IPLC/IEPL 专线物理延迟、0.01%丢包率、ChatGPT与流媒体全解锁能力。内附独家大额优惠券与横评报告。"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[{ label: '2026 翻墙机场权威排行榜' }]} />

    <!-- Page Header -->
    <header class="my-8 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-200 text-brand-700 text-xs font-semibold mb-4">
        🏆 实验室年度公信力榜单 · 11月更新
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-ink-heading tracking-tight leading-tight">
        2026 年度翻墙机场综合权威排行榜
      </h1>
      <p class="mt-4 text-ink-body text-sm sm:text-base leading-relaxed7">
        告别虚标带宽与晚高峰卡顿。机场社长实验室部署多地独立探针机房，对市面主流服务商进行长期压力测试，精选出 11 款具备内网物理专线保障的头部品牌。
      </p>
    </header>

    <!-- Scoring Methodology (E-E-A-T) -->
    <div class="my-10 bg-white border border-surface-border rounded-2xl p-6 sm:p-8 shadow-card">
      <h2 class="text-lg font-bold text-ink-heading mb-3 flex items-center gap-2">
        <span class="text-brand-600">⚖️</span>
        社长实验室评选标准与权重体系 (Methodology)
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-3 text-xs mt-4">
        <div class="p-3 rounded-xl bg-surface-subtle border border-surface-border">
          <span class="text-brand-700 font-bold block mb-1 font-mono">30% 晚高峰测速</span>
          <span class="text-ink-muted">20:00-23:00 骨干网千兆下行实跑</span>
        </div>
        <div class="p-3 rounded-xl bg-surface-subtle border border-surface-border">
          <span class="text-emerald-700 font-bold block mb-1 font-mono">25% 物理专线与丢包</span>
          <span class="text-ink-muted">深港/沪日 IPLC，丢包 &lt; 0.05%</span>
        </div>
        <div class="p-3 rounded-xl bg-surface-subtle border border-surface-border">
          <span class="text-indigo-700 font-bold block mb-1 font-mono">20% AI & 流媒体</span>
          <span class="text-ink-muted">ChatGPT 4o 与 Netflix 4K 全解</span>
        </div>
        <div class="p-3 rounded-xl bg-surface-subtle border border-surface-border">
          <span class="text-purple-700 font-bold block mb-1 font-mono">15% 资历与抗跑路</span>
          <span class="text-ink-muted">运营 3 年以上，自持机柜/资质</span>
        </div>
        <div class="p-3 rounded-xl bg-surface-subtle border border-surface-border">
          <span class="text-amber-700 font-bold block mb-1 font-mono">10% 性价比与客服</span>
          <span class="text-ink-muted">大额优惠码与工单退款响应</span>
        </div>
      </div>
    </div>

    <!-- Ranked Airport Cards List -->
    <div class="space-y-6">
      {airports.map((airport) => {
        const d = airport.data;
        return (
          <div class="bg-white border border-surface-border hover:border-brand-400 rounded-2xl p-6 transition-all shadow-card hover:shadow-card-hover flex flex-col md:flex-row items-stretch md:items-center justify-between gap-6">
            
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-surface-subtle flex items-center justify-center font-black text-xl text-brand-600 border border-surface-border shrink-0 font-mono">
                #{d.rankOrder}
              </div>
              <div class="space-y-1.5">
                <div class="flex items-center gap-2 flex-wrap">
                  <h3 class="text-xl font-bold text-ink-heading">
                    <a href={`/airports/${airport.slug}`} class="hover:text-brand-600 transition-colors">
                      {d.name}
                    </a>
                  </h3>
                  <span class="text-xs px-2 py-0.5 rounded bg-surface-subtle text-ink-body border border-surface-border">
                    {d.lineType}
                  </span>
                  {d.badge && (
                    <span class="text-xs px-2.5 py-0.5 rounded-full font-bold bg-amber-50 text-amber-800 border border-amber-200">
                      {d.badge}
                    </span>
                  )}
                </div>
                <p class="text-xs sm:text-sm text-ink-body">
                  {d.tagline}
                </p>
                <div class="flex items-center gap-3 text-xs text-ink-muted flex-wrap pt-1 font-mono">
                  <span class="text-brand-600 font-bold">⚡ 峰值: {d.metrics.peakSpeedMbps} Mbps</span>
                  <span>·</span>
                  <span class="text-emerald-700">延迟: {d.metrics.pingMs} ms</span>
                  <span>·</span>
                  <span class="text-ink-heading">丢包: {d.metrics.packetLoss}</span>
                </div>
              </div>
            </div>

            <!-- Price & Dual CTA -->
            <div class="flex flex-col sm:flex-row md:flex-col items-end justify-between gap-3 shrink-0 pt-4 md:pt-0 border-t md:border-t-0 border-surface-border">
              <div class="text-right">
                <span class="text-xs text-ink-muted">特惠价:</span>
                <span class="text-xl font-black text-ink-heading ml-1 font-mono">{d.currency}{d.priceMonthly}</span>
                <span class="text-xs text-ink-muted">/月起</span>
                {d.couponCode && (
                  <div class="text-[11px] text-brand-700 font-mono font-bold mt-0.5">
                    码: {d.couponCode} ({d.discountRate || '特惠'})
                  </div>
                )}
              </div>
              <div class="flex items-center gap-2 w-full sm:w-auto">
                <a
                  href={`/airports/${airport.slug}`}
                  class="px-3.5 py-2 rounded-xl bg-white border border-surface-border hover:border-slate-300 text-xs font-semibold text-ink-body hover:text-ink-heading transition-colors shadow-sm"
                >
                  评测详情
                </a>
                <a
                  href={`/go/${d.affiliateSlug}`}
                  target="_blank"
                  rel="nofollow sponsored noopener noreferrer"
                  class="px-4 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-bold shadow-sm transition-all flex items-center gap-1"
                >
                  <span>直达官网</span>
                  <span>➔</span>
                </a>
              </div>
            </div>

          </div>
        );
      })}
    </div>

  </div>

  <JsonLd schema={[itemListSchema, articleSchema]} />
</BaseLayout>
