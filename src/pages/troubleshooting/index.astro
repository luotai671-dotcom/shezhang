    <!-- ======================================================== -->
    <!-- 模块五：网络排障高频常见问答 (FAQ 12 问 Accordion) -->
    <!-- ======================================================== -->
    <section class="my-14" id="trouble-faq-section">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6 pb-3 border-b border-surface-border">
        <div>
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold mb-2">
            💡 疑难速查 · 核心解答
          </div>
          <h2 class="text-xl sm:text-2xl font-bold text-ink-heading flex items-center gap-2">
            <span>❓</span> <span>科学上网网络排障高频问答 (FAQ 12 问)</span>
          </h2>
          <p class="text-xs text-ink-muted mt-1">
            覆盖电脑断网急救、端口冲突、节点超时、AI防封及游戏NAT优化的权威实战解答
          </p>
        </div>
        <span class="text-xs font-mono font-bold px-3 py-1.5 rounded-xl bg-surface-subtle text-ink-heading border border-surface-border shrink-0 self-start sm:self-auto">
          收录 12 问
        </span>
      </div>

      <!-- FAQ Accordion Container (2 Columns) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {troubleFaqs.map((faq) => (
          <details class="group bg-white border border-surface-border hover:border-brand-300 rounded-2xl p-5 shadow-sm transition-all duration-200 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-start justify-between gap-3 cursor-pointer select-none">
              <div class="flex items-start gap-2.5">
                <span class="w-6 h-6 rounded-md bg-rose-50 text-rose-700 font-mono font-black text-xs flex items-center justify-center shrink-0 border border-rose-200 mt-0.5">
                  Q{faq.id}
                </span>
                <div>
                  <h3 class="text-sm font-bold text-ink-heading group-hover:text-brand-600 transition-colors leading-snug">
                    {faq.q}
                  </h3>
                  <span class="inline-block mt-1 text-[10px] font-mono font-semibold px-2 py-0.5 rounded bg-surface-subtle text-ink-muted border border-surface-border">
                    #{faq.tag}
                  </span>
                </div>
              </div>
              <svg
                class="w-5 h-5 text-ink-muted group-hover:text-brand-600 transition-transform duration-200 shrink-0 group-open:rotate-180 mt-1"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="pt-3 mt-3 border-t border-surface-border text-xs sm:text-sm text-ink-body leading-relaxed pl-8">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

  </div>

  <!-- Schema.org FAQPage Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
