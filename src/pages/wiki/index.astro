---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import { getCollection } from 'astro:content';

const allGuides = await getCollection('guides');

// Defined 10 core SEO topic cluster articles in exact sequence
const targetSlugs = [
  'iplc-vs-iepl-guide',
  'chatgpt-claude-unlock-guide',
  'streaming-netflix-4k-8k-airport-recommendation',
  'cheap-budget-airport-recommendation',
  'cross-border-ecommerce-tiktok-airport-recommendation',
  'pay-as-you-go-non-expiring-airport-recommendation',
  'hysteria2-tuic-v5-nextgen-protocol-airport-recommendation',
  'gaming-steam-low-latency-airport-recommendation',
  'beginner-anti-scam-airport-guide',
  'exclusive-airport-coupons-yearly-discount-guide',
];

const topicArticles = targetSlugs.map((slug, idx) => {
  const guide = allGuides.find((g) => g.slug === slug);
  if (guide) return { ...guide, serialNo: idx + 1 };
  return null;
}).filter(Boolean);

const glossary = [
  { term: 'IPLC (国际私有租用线路)', def: 'International Private Leased Circuit，跨境两端通过物理点对点海底光缆内网直通，完全不过国家防火墙 (GFW) 检查，晚高峰无拥堵。' },
  { term: 'IEPL (国际以太网专线)', def: 'International Ethernet Private Line，以太网架构的点对点专线，具备极高带宽弹性与极低物理抖动，是 2026 年高端机场骨干主流。' },
  { term: 'BGP (边界网关协议中继)', def: '通过国内电信/联通/移动多线机房智能选路中转，再经公网出口到达境外，成本相对低廉，但晚高峰受国际公网骨干网拥堵影响。' },
  { term: 'Hysteria 2 协议', def: '基于 UDP QUIC 重构的极速抗丢包加速协议，即便在 20% 弱网丢包环境下依然能凭借拥塞控制跑满千兆带宽。' },
  { term: 'UDP FullCone (NAT 1)', def: '全锥型 NAT 网络类型，外服游戏（Switch、PS5、Xbox、Steam 联机）无需端口转发即可实现极速直连组队语音。' },
  { term: '原生住宅 IP (Residential IP)', def: '由海外本土家庭宽带运营商（如 AT&T、Verizon、HKT）直接分配的 IP，纯净度极高，100% 免疫 ChatGPT 与流媒体封控。' },
];

const categoryPills: Record<string, string> = {
  'iplc-vs-iepl-guide': '专线架构科普',
  'chatgpt-claude-unlock-guide': 'AI生产力防封',
  'streaming-netflix-4k-8k-airport-recommendation': '4K/8K流媒体',
  'cheap-budget-airport-recommendation': '平价高性价比',
  'cross-border-ecommerce-tiktok-airport-recommendation': '跨境出海电商',
  'pay-as-you-go-non-expiring-airport-recommendation': '不限时按量',
  'hysteria2-tuic-v5-nextgen-protocol-airport-recommendation': '前沿抗封协议',
  'gaming-steam-low-latency-airport-recommendation': '外服电竞加速',
  'beginner-anti-scam-airport-guide': '新手防坑鉴毒',
  'exclusive-airport-coupons-yearly-discount-guide': '独家大额优惠',
};

// ========================================================
// 30 个高热搜、高权重「机场推荐」长尾 FAQ 矩阵 (每题约 150 字)
// ========================================================
