---
import { AFFILIATE_LINKS, getAffiliateRedirect } from '../../utils/affiliate';
import '../../styles/global.css';

export function getStaticPaths() {
  return Object.keys(AFFILIATE_LINKS).map((slug) => ({
    params: { slug },
    props: { linkConfig: AFFILIATE_LINKS[slug] },
  }));
}

const { slug } = Astro.params;
const { linkConfig } = Astro.props;

const targetUrl = getAffiliateRedirect(slug || '', 'cloaked_redirect');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>正在前往 {linkConfig.name} 官网专属优惠通道 | 机场社长</title>
    
    <!-- Meta Refresh Fallback -->
    <meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <script define:vars={{ targetUrl }}>
      // Immediate redirection
      window.location.replace(targetUrl);
    </script>
  </head>
  <body class="bg-surface-subtle text-ink-body min-h-screen flex items-center justify-center p-4 font-sans">
    <div class="max-w-md w-full text-center space-y-6 bg-white border border-surface-border p-8 rounded-3xl shadow-xl">
      
      <!-- Spinner -->
      <div class="relative w-14 h-14 mx-auto">
        <div class="w-14 h-14 rounded-full border-4 border-brand-100 border-t-brand-600 animate-spin"></div>
        <div class="absolute inset-0 flex items-center justify-center text-xs font-bold text-brand-600 font-mono">
          GO
        </div>
      </div>

      <div class="space-y-2">
        <h1 class="text-xl font-bold text-ink-heading">
          正在为您安全跳转至官网...
        </h1>
        <p class="text-xs text-ink-muted leading-relaxed">
          已自动激活机场社长专属合作通道与 <span class="text-brand-700 font-semibold font-mono">{linkConfig.discount || '独家折扣'}</span>
        </p>
      </div>

      {linkConfig.couponCode && (
        <div class="bg-surface-subtle p-3.5 rounded-xl border border-surface-border text-xs">
          <span class="text-ink-muted">专属优惠代码：</span>
          <code class="px-2 py-0.5 rounded bg-white text-brand-700 font-mono font-bold text-sm border border-brand-200 shadow-sm">
            {linkConfig.couponCode}
          </code>
        </div>
      )}

      <div>
        <a
          href={targetUrl}
          target="_blank"
          rel="nofollow sponsored noopener noreferrer"
          class="inline-block px-6 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs shadow-sm transition-all"
        >
          如未自动跳转，请点击此处直达 ➔
        </a>
      </div>

      <div class="text-[11px] text-ink-muted">
        🛡️ 机场社长 7×24H 探针实验室安全审计认证通道
      </div>

    </div>
  </body>
</html>
